APP_ENV=development
DATABASE_URL=sqlite:///./learnflow.db

# Which AI provider implementation to use: gemini | openai | claude
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# Cheapest/fastest current option: gemini-3.1-flash-lite
# Higher quality, still cheap: gemini-3.5-flash
# If both 404 for you, Google has moved the lineup again — check
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.1-flash-lite
# Used for RAG (document chunk + query embeddings), not for text
# generation — see backend/app/services/ai/gemini_embedding_provider.py
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Must match the URL the React dev server runs on
FRONTEND_ORIGIN=http://localhost:5173

# Guest identity/session (V3 Milestone 1 Phase 1) — see
# backend/app/api/deps.py and backend/app/services/guest_session_service.py.
# Safe to leave at these defaults for local development.
GUEST_SESSION_INACTIVITY_MINUTES=45
GUEST_SESSION_COOKIE_NAME=learnflow_guest_session
# Set to true (and GUEST_SESSION_COOKIE_SAMESITE=none) once the
# frontend and backend are served over HTTPS on different sites —
# see the settings' own docstrings in app/core/config.py.
GUEST_SESSION_COOKIE_SECURE=false
GUEST_SESSION_COOKIE_SAMESITE=lax
